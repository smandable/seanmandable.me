---
/*
 * The "Debt Descent / <page>" trail above a tool page's h1, plus the matching
 * BreadcrumbList structured data so search results can show the same trail.
 * The list items stay inline so a long page name wraps the way plain text
 * does. The link is inline-block so Lighthouse doesn't treat it as a link in
 * running text, which it would flag for differing from its neighbors only by
 * color.
 */
interface Props {
  parent: { name: string; href: string };
  current: string;
}

const { parent, current } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: parent.name, item: new URL(parent.href, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: current, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<nav aria-label="Breadcrumb" class="text-sm font-medium">
  <ol>
    <li class="inline"><a href={parent.href} class="inline-block no-underline text-accent-600 transition-colors hover:text-accent-700">{parent.name}</a></li><li class="inline text-slate-500"><span aria-hidden="true"> / </span><span aria-current="page">{current}</span></li>
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
