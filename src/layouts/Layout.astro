---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/resume';

type Props = {
  title?: string;
  description?: string;
  /** Verbatim <title>, skipping the "— {name}" suffix (for SEO-targeted pages). */
  fullTitle?: string;
  /** App Store numeric id — renders the apple-itunes-app meta so iOS Safari shows a Smart App Banner. */
  appleAppId?: string;
  /** Make <main> a flex column so page content can distribute spare viewport height (mt-auto). */
  fillMain?: boolean;
};

const { title, description = `${profile.name} — ${profile.title}`, appleAppId, fillMain = false } = Astro.props;
const fullTitle = Astro.props.fullTitle ?? (title ? `${title} — ${profile.name}` : profile.name);

// Canonical/OG URL: the site is served from directory indexes, so Apache's
// canonical form of every non-root path ends in a slash.
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);

// Social cards are per-page; the homepage keeps its richer hand-written pair.
const ogTitle = title ? fullTitle : 'Sean Mandable, Senior Software Engineer & Full-Stack Dev';
const ogDescription = Astro.props.description
  ?? 'Full-stack web (Vue, Angular, TypeScript, Node) + Swift/SwiftUI. I notice when things are off and can’t quite leave them there.';

// Bump this when any /favicon.* or /apple-touch-icon.png changes so browsers
// refetch instead of serving stale cached versions.
const ICON_VERSION = '2';
---

<!doctype html>
<html lang="en" class="bg-white text-slate-900 antialiased">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${ICON_VERSION}`} />
    <link rel="icon" href={`/favicon.ico?v=${ICON_VERSION}`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${ICON_VERSION}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content="https://www.seanmandable.me/og-image.png" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content="https://www.seanmandable.me/og-image.png" />
    {appleAppId && <meta name="apple-itunes-app" content={`app-id=${appleAppId}`} />}
    <title>{fullTitle}</title>
    {import.meta.env.PROD && (
      <Fragment>
        {/* Self opt-out of analytics: visit any page with ?notme to stop Umami
            counting this browser (?notme=off to re-enable). Sets Umami's
            documented `umami.disabled` localStorage flag, which the tracker
            below checks before sending anything. Runs synchronously before the
            deferred tracker, and strips the param so it isn't left in the URL. */}
        <script is:inline>
          (function () {
            try {
              var p = new URLSearchParams(location.search);
              if (!p.has('notme')) return;
              var v = p.get('notme');
              if (v === 'off' || v === '0') localStorage.removeItem('umami.disabled');
              else localStorage.setItem('umami.disabled', '1');
              p.delete('notme');
              var q = p.toString();
              history.replaceState(null, '', location.pathname + (q ? '?' + q : '') + location.hash);
            } catch (e) {}
          })();
        </script>
        {/* Sitewide link-click tracking: stamp Umami's event attributes on
            every link that doesn't already declare a named event (footer,
            contact, resume button keep theirs). The tracker's own delegated
            click handler then reports a `link-click` event with the
            destination and link text — and for same-tab navigation it holds
            the click until the event is sent, so clicks aren't lost to page
            unload. */}
        <script is:inline>
          document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('a[href]:not([data-umami-event])').forEach(function (a) {
              a.setAttribute('data-umami-event', 'link-click');
              a.setAttribute('data-umami-event-href', a.getAttribute('href'));
              var clone = a.cloneNode(true);
              clone.querySelectorAll('.sr-only').forEach(function (s) { s.remove(); });
              var text = (clone.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 80);
              if (text) a.setAttribute('data-umami-event-text', text);
            });
          });
        </script>
        <script
          is:inline
          defer
          data-website-id="7ccf0608-b402-47a9-8a95-36710ac0492f"
          src="https://cloud.umami.is/script.js"
        />
      </Fragment>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-slate-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href="/" class="text-lg font-semibold tracking-tight">{profile.name}</a>
        <Nav />
      </div>
    </header>
    <main class:list={['mx-auto w-full max-w-5xl flex-1 px-6 py-12', fillMain && 'flex flex-col']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
