---
import Layout from '../layouts/Layout.astro';
import AppSchema from '../components/AppSchema.astro';

// Captured from ModernPAR's own window code on a demo set: three RAR volumes
// damaged or missing, then repaired from the recovery blocks.
const screenshots = [
  {
    name: 'damage',
    alt: 'ModernPAR window listing an 11-volume PAR2 set. Three volumes have yellow warning icons, and the status line says damage was found and repair is possible.',
    caption: 'Verify flags one missing volume and two damaged ones.',
  },
  {
    name: 'restored',
    alt: 'The same window after repair. All 11 volumes have green checkmarks, and the status line reads Files restored successfully.',
    caption: 'Repair rebuilds all three from the recovery blocks, then extraction starts on its own.',
  },
];

// The questions people search for before downloading, rendered as the
// visible FAQ and serialized as FAQPage JSON-LD. Facts checked against the
// ModernPAR repo on 2026-10-16: arm64-only on macOS 14+, GPL-2.0-or-later,
// not on the Mac App Store because of the GPL, RAR 2/3/5 and zip extraction,
// repair and post-processing on by default, Sparkle updates from GitHub
// Releases, and no network use besides Sparkle.
const faqs = [
  {
    q: 'What are PAR2 files for?',
    a: 'They hold recovery data for a set of files, usually the RAR volumes of a Usenet download. When part of the set arrives damaged or missing, ModernPAR uses the recovery blocks in the .par2 files to rebuild it, as long as there are enough blocks to cover the damage.',
  },
  {
    q: 'Does ModernPAR replace MacPAR deLuxe?',
    a: 'Yes. It handles the same PAR2 and PAR1 sets and runs natively on Apple Silicon. MacPAR deLuxe is Intel-only, so it runs through Rosetta 2 and will stop working when Apple retires Rosetta.',
  },
  {
    q: 'Does it run on Intel Macs?',
    a: 'No. ModernPAR is built for Apple Silicon only.',
  },
  {
    q: 'Is it free?',
    a: 'Yes. There’s nothing to pay for, and the source code is on GitHub.',
  },
  {
    q: 'Why isn’t it on the Mac App Store?',
    a: 'ModernPAR and its PAR2 engine, par2cmdline-turbo, are licensed under the GPL, and the GPL’s terms conflict with the Mac App Store’s. It’s a signed, notarized download from GitHub instead.',
  },
  {
    q: 'Can it create PAR2 files?',
    a: 'Yes. Add the files (all from one folder), pick the redundancy, and ModernPAR writes the index and recovery files into that folder. The sets it makes verify in par2cmdline and MultiPar too.',
  },
  {
    q: 'Which archives can it extract?',
    a: 'RAR versions 2, 3, and 5 (multi-volume, password-protected, and encrypted-header archives too), and zip, including ZipCrypto and WinZip AES. ModernPAR extracts a set as soon as it verifies or is repaired. To stop that, turn off Automatically post-process files after repair in Settings ▸ Post-processing.',
  },
  {
    q: 'Why does ModernPAR ask for access to a folder?',
    a: 'ModernPAR runs in the macOS App Sandbox, so it can read and write only the folders you hand it. A set needs its whole folder to read the other volumes and write the repaired or extracted output. The first time you open something in a folder, a panel asks you to grant access to that folder. The grant is remembered across launches, and granting a parent folder covers everything inside it.',
  },
  {
    q: 'Does it collect any data?',
    a: 'No. It has no analytics, and it goes online only to check for updates. Sparkle reads ModernPAR’s release list on GitHub, every update is signed, and the updater shows the release notes before installing.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout
  ogImage="/og/modern-par.png"
  title="ModernPAR, a MacPAR deLuxe Replacement"
  description="ModernPAR is a free, arm64-native replacement for MacPAR deLuxe. It repairs PAR2 and PAR1 sets, creates recovery sets, and extracts RAR and zip archives."
>
  <div class="flex flex-col items-center py-12 text-center sm:py-20">
    <div class="flex max-w-[65ch] flex-col items-center">
      <img
        src="/app-icons/modernpar.webp"
        alt=""
        width="128"
        height="128"
        class="h-32 w-32 rounded-[22.5%] shadow-md ring-1 ring-slate-900/10"
      />
      <h1 class="mt-8 text-3xl font-bold tracking-tight sm:text-4xl">ModernPAR</h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        An arm64-native replacement for MacPAR deLuxe. Verify and repair PAR2 and PAR1
        sets, create new recovery sets, and extract RAR and zip archives.
        Drop a <code class="rounded bg-slate-100 px-1 py-0.5 text-base">.par2</code> file on the
        window and it verifies, repairs any damage, then extracts what’s inside.
      </p>
      <a
        href="https://github.com/smandable/ModernPAR/releases/latest"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center gap-2 rounded-md bg-accent-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-700"
        data-umami-event="modernpar-github-download"
      >
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z" />
          <path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z" />
        </svg>
        Download the .dmg<span class="sr-only"> (opens in new tab)</span>
      </a>
      <p class="mt-4 text-sm text-slate-500">
        Signed and notarized, for Apple Silicon Macs on macOS 14 or later. Updates
        itself through Sparkle. Free software under GPL-2.0-or-later.
      </p>
    </div>
    <div class="mt-12 flex w-full max-w-3xl flex-col gap-12 sm:mt-16">
      {screenshots.map((shot) => (
        <figure>
          <img
            src={`/screenshots/modern-par-${shot.name}-1x.webp`}
            srcset={`/screenshots/modern-par-${shot.name}-1x.webp 790w, /screenshots/modern-par-${shot.name}-2x.webp 1580w`}
            sizes="(min-width: 816px) 768px, calc(100vw - 48px)"
            width="790"
            height="440"
            alt={shot.alt}
            decoding="async"
            class="h-auto w-full [filter:drop-shadow(0_0_0.5px_rgb(15_23_42/0.35))_drop-shadow(0_16px_32px_rgb(15_23_42/0.12))]"
          />
          <figcaption class="mt-4 text-sm text-slate-500">{shot.caption}</figcaption>
        </figure>
      ))}
    </div>
    <nav
      class="mt-12 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-slate-500"
      aria-label="ModernPAR links"
    >
      <a href="/projects/#modern-par" class="transition-colors hover:text-accent-600">More about the app</a>
      <a
        href="https://github.com/smandable/ModernPAR"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-accent-600"
      >GitHub<span class="sr-only"> (opens in new tab)</span></a>
      <a
        href="https://github.com/smandable/ModernPAR/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-accent-600"
      >Report an issue<span class="sr-only"> (opens in new tab)</span></a>
    </nav>

    <section class="mt-16 w-full max-w-3xl text-left" aria-labelledby="faq">
      <h2 id="faq" class="text-xl font-bold tracking-tight">Questions before you download</h2>
      <dl class="mt-4 space-y-6">
        {faqs.map(({ q, a }) => (
          <div>
            <dt class="font-semibold text-slate-900">{q}</dt>
            <dd class="mt-1 leading-relaxed text-slate-600">{a}</dd>
          </div>
        ))}
      </dl>
    </section>
    <a
      href="https://alternativeto.net/software/modernpar/about/?utm_source=badge&utm_medium=referral"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8"
      data-umami-event="modernpar-alternativeto-badge"
    >
      <img
        src="/badges/alternativeto-light.svg"
        alt="ModernPAR on AlternativeTo"
        width="183"
        height="62"
      /><span class="sr-only"> (opens in new tab)</span>
    </a>
  </div>
  <AppSchema name="ModernPAR" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</Layout>
