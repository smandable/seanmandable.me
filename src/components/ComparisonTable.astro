---
/*
 * A two-product comparison table for the /debt-descent/vs-* pages. Cells are
 * plain text so every claim stays readable and quotable; sources live in the
 * page's Sources list. Scrolls sideways on narrow screens.
 */
interface Row {
  label: string;
  a: string;
  b: string;
}

interface Props {
  caption: string;
  columns: [string, string];
  rows: Row[];
}

const { caption, columns, rows } = Astro.props;
---

<div class="mt-4 overflow-x-auto rounded-lg border border-slate-200">
  <table class="w-full min-w-[36rem] text-left text-sm">
    <caption class="sr-only">{caption}</caption>
    <thead class="bg-slate-50 text-xs text-slate-600">
      <tr>
        <th scope="col" class="w-[26%] px-3 py-2 font-medium"></th>
        <th scope="col" class="w-[37%] px-3 py-2 font-semibold text-slate-900">{columns[0]}</th>
        <th scope="col" class="w-[37%] px-3 py-2 font-semibold text-slate-900">{columns[1]}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-t border-slate-100 align-top">
          <th scope="row" class="px-3 py-2.5 font-medium text-slate-600">{row.label}</th>
          <td class="px-3 py-2.5 leading-relaxed text-slate-900">{row.a}</td>
          <td class="px-3 py-2.5 leading-relaxed text-slate-900">{row.b}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
