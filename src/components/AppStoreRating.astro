---
/*
 * "★★★★★ Rated 5 stars on the App Store" under a landing page's App Store
 * badge, from today's average at build time ("Rated 4.8 out of 5" if it's
 * below 5). The number of ratings is left out on purpose. Renders nothing if
 * the lookup fails.
 */
import { appStoreRating } from '../lib/app-store-rating';

interface Props {
  appId: string;
}

const rating = await appStoreRating(Astro.props.appId);
const stars = rating ? Math.round(rating.average) : 0;
const score = rating && rating.average >= 4.95 ? '5 stars' : `${rating?.average.toFixed(1)} out of 5`;
---

{rating && (
  <p class="mt-3 text-sm text-slate-600">
    <span class="tracking-wider text-amber-500" aria-hidden="true">{'★'.repeat(stars)}{'☆'.repeat(5 - stars)}</span>
    {' '}Rated {score} on the App Store
  </p>
)}
