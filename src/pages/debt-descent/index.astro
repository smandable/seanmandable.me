---
import Layout from '../../layouts/Layout.astro';
import { appStoreUrl, comparisons, tools } from '../../data/debt-descent';
---

<Layout
  title="Debt Descent"
  description="Debt Descent is a private, native debt-payoff planner for iPhone, iPad, and Mac. Compare Snowball, Avalanche, and more against your own numbers, all on your device."
  appleAppId="6785269702"
>
  <div class="mx-auto flex max-w-[65ch] flex-col items-center py-12 text-center sm:py-20">
    <img
      src="/app-icons/debt-descent.png?v=2"
      alt=""
      width="128"
      height="128"
      class="h-32 w-32 rounded-[22.5%] shadow-md ring-1 ring-slate-900/10"
    />
    <h1 class="mt-8 text-3xl font-bold tracking-tight sm:text-4xl">Debt Descent</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600">
      A native debt-payoff planner for iPhone, iPad, and Mac. Add your debts, compare
      Snowball and Avalanche side by side, and see exactly when you’ll be debt-free.
      Nothing ever leaves your own devices.
    </p>
    <a
      href={appStoreUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-block transition-opacity hover:opacity-80"
      data-umami-event="debt-descent-app-store"
    >
      <img
        src="https://toolbox.marketingtools.apple.com/api/v2/badges/download-on-the-app-store/black/en-us"
        alt="Download on the App Store"
        width="150"
        height="50"
        class="h-[50px] w-auto"
      />
      <span class="sr-only"> (opens in new tab)</span>
    </a>
    <nav class="mt-12 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-slate-500" aria-label="Debt Descent links">
      <a href="/projects#debt-descent" class="transition-colors hover:text-accent-600">More about the app</a>
      <a href="/debt-descent/support" class="transition-colors hover:text-accent-600">Support</a>
      <a href="/debt-descent/privacy" class="transition-colors hover:text-accent-600">Privacy Policy</a>
    </nav>

    <section class="mt-16 w-full text-left" aria-labelledby="free-tools">
      <h2 id="free-tools" class="text-xl font-bold tracking-tight">Free tools</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">
        Calculators that run in your browser. No sign-up, and nothing you type is saved or sent.
      </p>
      <ul class="mt-4 space-y-3">
        {tools.map((t) => (
          <li class="leading-relaxed text-slate-600">
            <a href={t.href} class="font-medium text-accent-600 transition-colors hover:text-accent-700">{t.title}</a>:
            {' '}{t.blurb}.
          </li>
        ))}
      </ul>
      {comparisons.length > 0 && (
        <Fragment>
          <h2 class="mt-10 text-xl font-bold tracking-tight">Compared with other planners</h2>
          <ul class="mt-4 space-y-2">
            {comparisons.map((c) => (
              <li>
                <a href={c.href} class="font-medium text-accent-600 transition-colors hover:text-accent-700">{c.title}</a>
              </li>
            ))}
          </ul>
        </Fragment>
      )}
    </section>
  </div>
</Layout>
