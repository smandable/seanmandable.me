---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="There's no page at this address.">
  <div class="mx-auto flex max-w-[65ch] flex-col items-center py-12 text-center sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">There's no page here</h1>
    <p class="mt-4 max-w-prose text-lg leading-relaxed text-slate-600">
      Maybe the link had a typo, maybe I moved something and didn't leave a
      redirect. Either way, something on this site is a little off — and for
      once it's mine.
    </p>
    <nav
      class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-slate-500"
      aria-label="Places to go instead"
    >
      <a href="/" class="transition-colors hover:text-accent-600">Home</a>
      <a href="/projects" class="transition-colors hover:text-accent-600">Projects</a>
      <a href="/work" class="transition-colors hover:text-accent-600">Work</a>
      <a href="/writing" class="transition-colors hover:text-accent-600">Writing</a>
      <a href="/contact" class="transition-colors hover:text-accent-600">Contact</a>
    </nav>
  </div>
</Layout>
