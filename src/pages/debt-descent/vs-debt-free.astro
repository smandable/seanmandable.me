---
import Layout from '../../layouts/Layout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import DebtDescentAppCta from '../../components/DebtDescentAppCta.astro';
import DebtDescentTools from '../../components/DebtDescentTools.astro';

const title = 'Debt Descent vs Debt Free';
const fullTitle = 'Debt Descent vs Debt Free: Two Debt Payoff Apps Compared';
const description =
  'Debt Descent and Mobile Innovations’ Debt Free – Pay Off Debt Faster compared on price, platforms, privacy, free features, and the paid tiers, as of September 2026, with sources. Written by the developer of Debt Descent, and it says where Debt Free is the better pick.';

const columns: [string, string] = ['Debt Descent', 'Debt Free'];

const priceRows = [
  {
    label: 'Price',
    a: 'Free. Pro is $14.99 once, and one purchase covers your iPhone, iPad, and Mac.',
    b: 'Free. Premium is $9.99 a year (“Pro Upgrade - Yearly” on the listing). The listing also shows a $1.99 “Pro Upgrade” and doesn’t say what it covers.',
  },
  {
    label: 'Paid tier over three years',
    a: '$14.99',
    b: '$29.97 on the yearly plan.',
  },
  {
    label: 'Platforms',
    a: 'Native app for iPhone, iPad, and Mac.',
    b: 'iPhone, iPad, Apple Watch, and Apple Vision Pro (iOS 18.6 or later). On a Mac it runs as the iPad app, which the listing marks “Designed for iPad. Not verified for macOS.”',
  },
  {
    label: 'Account',
    a: 'None.',
    b: 'None.',
  },
  {
    label: 'App Store privacy label',
    a: '“Data Not Collected.”',
    b: '“Data Not Collected.”',
  },
  {
    label: 'Ads',
    a: 'None.',
    b: 'None.',
  },
  {
    label: 'Accessibility on the listing',
    a: 'VoiceOver, Larger Text, and Dark Interface.',
    b: 'None declared yet.',
  },
  {
    label: 'Languages',
    a: 'English.',
    b: 'English and Japanese.',
  },
];

const freeRows = [
  {
    label: 'Debts',
    a: 'Unlimited, with notes on each one.',
    b: 'Unlimited.',
  },
  {
    label: 'Payoff methods',
    a: 'Snowball and Avalanche. Pro adds five more, including a custom order, plus planned windfalls: one-time extra payments, the same idea as a Snowflake.',
    b: 'Snowball, Avalanche, Snowflake (windfalls), Highest Balance, and Custom, compared side by side.',
  },
  {
    label: 'Payment logging',
    a: 'Yes, with progress against the plan and the interest your paydown has already saved. Due-date reminders are Pro.',
    b: 'Yes, with due-date reminders. Auto-pay tracking is Premium.',
  },
  {
    label: 'Statement import',
    a: 'Reads a statement PDF, a photo, or a camera scan on your device and fills in the balance, APR, minimum, and due date for you to confirm. Paystubs too.',
    b: 'Scans a card or loan statement with the camera to fill in a new debt, since version 8.2 in September 2026.',
  },
  {
    label: 'Bank sync',
    a: 'None. It reads your statements instead.',
    b: 'None. It can import card transactions from Apple Wallet.',
  },
  {
    label: 'Sync and backup',
    a: 'Through your own iCloud, free, plus JSON export and import (a plan PDF imports too).',
    b: 'Through iCloud. PDF reports and CSV export are Premium.',
  },
  {
    label: 'Widgets, Siri, Spotlight',
    a: 'Yes, and the medium widget logs your next payment in one tap.',
    b: 'Yes.',
  },
  {
    label: 'Debt management plan',
    a: 'Payment groups: one payment, the plan’s fee, and the member debts, with the fee kept out of the payoff math.',
    b: 'Not mentioned by the developer.',
  },
  {
    label: 'Deferment and promos',
    a: 'Student-loan deferment with an end date, 0% intro APRs that revert on a date, and deferred-interest promos tracked for deadline warnings.',
    b: 'Not mentioned by the developer.',
  },
  {
    label: 'Income and bills',
    a: 'A Left over card: take-home pay at your pay cadence, minus the bills the plan doesn’t track. You can save up for something there too, and see what charging it would cost instead.',
    b: 'Bill tracking and saving goals are Premium.',
  },
  {
    label: 'Calculators',
    a: 'Four free calculators on this site: Snowball and Avalanche, deferred interest, balance transfer, and debt management plans.',
    b: 'Debt payoff, loan, and mortgage calculators in the app.',
  },
];

const paidRows = [
  {
    label: 'What the paid tier adds',
    a: 'Five more payoff methods (custom order, highest interest, cash-flow index, credit utilization, credit-score impact), a what-if slider and per-debt payoff tests, picking a debt-free date and seeing the extra it takes, planned windfalls, refinance and balance-transfer modeling with one-step apply, amortization schedules, PDF and calendar export, and due-date reminders.',
    b: 'An AI Debt Coach, the Apple Watch app, Household Mode for up to 10 people, bill tracking, and PDF reports and CSV export.',
  },
  {
    label: 'How you pay',
    a: 'Once. Offer codes for discounts; Family Sharing.',
    b: 'Yearly, with Family Sharing.',
  },
];
---

<Layout title={title} fullTitle={fullTitle} description={description} appleAppId="6785269702">
  <div class="mx-auto max-w-3xl">
    <p class="text-sm font-medium">
      <a href="/debt-descent/" class="no-underline text-accent-600 transition-colors hover:text-accent-700">Debt Descent</a>
      <span class="text-slate-400"> / vs Debt Free</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Debt Descent vs Debt Free</h1>
    <p class="mt-2 text-xl font-medium text-slate-700">Two debt-payoff apps compared, as of September 2026.</p>
    <p class="mt-4 max-w-[65ch] text-lg leading-relaxed text-slate-600">
      Debt Free – Pay Off Debt Faster is Mobile Innovations’ app, on the App Store since 2010 and,
      by its own count, used by more than 300,000 people. Several apps share the name; this page is
      about the Mobile Innovations one. Of the apps I’ve compared, it’s the closest to Debt Descent.
      It’s free for unlimited debts, has no ads and no account, and its App Store privacy label is
      “Data Not Collected.” Debt Descent is my native app for iPhone, iPad, and Mac, free with a one-time
      $14.99 Pro purchase. Here is how they line up, with the sources at the bottom. Where Debt Free
      is the better pick, I say so.
    </p>

    <section class="mt-10 max-w-[65ch]">
      <h2 class="text-2xl font-bold tracking-tight">The short version</h2>
      <ul class="mt-4 list-disc space-y-3 pl-5 leading-relaxed text-slate-600">
        <li><strong class="font-semibold text-slate-900">Pick Debt Free</strong> if you want an Apple Watch app, a plan shared with your household, or an AI coach, or want the app in Japanese.</li>
        <li><strong class="font-semibold text-slate-900">Pick Debt Descent</strong> if you want a native Mac app, a price you pay once, or a model for a debt management plan, a student loan in deferment, or a deferred-interest promo.</li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight">Price, platforms, and privacy</h2>
      <ComparisonTable caption="Price, platforms, and privacy" columns={columns} rows={priceRows} />
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight">What’s free</h2>
      <ComparisonTable caption="What each app includes for free" columns={columns} rows={freeRows} />
      <p class="mt-3 max-w-[65ch] text-sm leading-relaxed text-slate-500">
        “Not mentioned by the developer” means exactly that: the App Store listing doesn’t list it.
        It may exist in the app. I haven’t claimed a feature is missing where I couldn’t check.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight">The paid tiers</h2>
      <ComparisonTable caption="Debt Descent Pro and Debt Free Premium" columns={['Debt Descent Pro, $14.99 once', 'Debt Free Premium, $9.99 a year']} rows={paidRows} />
    </section>

    <section class="mt-12 max-w-[65ch]">
      <h2 class="text-2xl font-bold tracking-tight">What Debt Free does better</h2>
      <ul class="mt-4 list-disc space-y-3 pl-5 leading-relaxed text-slate-600">
        <li>An Apple Watch app, Live Activities, and the Dynamic Island, with Premium.</li>
        <li>Household Mode, with Premium: one plan shared with up to 10 people, and any of them can record a payment.</li>
        <li>Due-date reminders on the free tier. Debt Descent’s are Pro.</li>
        <li>Card transactions imported from Apple Wallet.</li>
        <li>An AI coach on Apple Intelligence, and bill tracking, saving goals, and a net-worth tracker, with Premium.</li>
        <li>On the App Store since 2010, with more than 300,000 users by the developer’s count.</li>
        <li>It’s in Japanese as well as English.</li>
      </ul>

      <h2 class="mt-12 text-2xl font-bold tracking-tight">What Debt Descent does better</h2>
      <ul class="mt-4 list-disc space-y-3 pl-5 leading-relaxed text-slate-600">
        <li>A native Mac app, with a menu bar item and its own text-size setting. On a Mac, Debt Free runs as its iPad app.</li>
        <li>A price you pay once: $14.99 for Pro on every device, against $9.99 a year for Debt Free Premium. Over three years that’s $14.99 against $29.97.</li>
        <li>It has a model for a debt management plan and its fee, a student loan in deferment, and a store promo with a deferred-interest deadline.</li>
        <li>Refinance and balance-transfer modeling that you can apply to your plan in one step.</li>
        <li>It reads a statement PDF or a photo as well as a camera scan, and paystubs too, all on the device.</li>
        <li>Its App Store listing declares VoiceOver, Larger Text, and Dark Interface. Debt Free’s doesn’t declare any yet, though its recent release notes mention VoiceOver and larger text.</li>
      </ul>

      <h2 class="mt-12 text-2xl font-bold tracking-tight">Which should you use?</h2>
      <p class="mt-4 leading-relaxed text-slate-600">
        Since both are free for unlimited debts and collect nothing, it comes down to the extras. If you want an Apple Watch app, a plan your household shares, or
        an AI coach, use Debt Free. If you want a native Mac app and a price you pay once, or you’re
        on a debt management plan, paying a student loan in deferment, or paying off a
        deferred-interest promo before its deadline, use Debt Descent. Both will get you to the same debt-free date on the same numbers.
        Try both free tiers first.
      </p>
    </section>

    <DebtDescentAppCta heading="Try Debt Descent free" event="debt-descent-vs-debt-free-app-store">
      Add your debts, or scan a statement, and compare Snowball and Avalanche on your own numbers.
      No account, no ads, and nothing leaves your device. Pro is a one-time $14.99 if you want the
      extra methods and tools. Or start with the free{' '}
      <a href="/debt-descent/calculator/" class="font-medium text-accent-600 transition-colors hover:text-accent-700">Snowball and Avalanche calculator</a> in your browser.
    </DebtDescentAppCta>

    <section class="mt-16 max-w-[65ch]">
      <h2 class="text-2xl font-bold tracking-tight">Sources</h2>
      <p class="mt-4 leading-relaxed text-slate-600">
        Everything about Debt Free above comes from the developer’s own App Store listing, read on
        September 28, 2026:
      </p>
      <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-slate-600">
        <li><a href="https://apps.apple.com/us/app/id407366192" target="_blank" rel="noopener noreferrer" class="font-medium text-accent-600 transition-colors hover:text-accent-700">The App Store listing<span class="sr-only"> (opens in new tab)</span></a> (version 8.2.2, September 26, 2026): the in-app purchase prices, the privacy label, the platforms, the accessibility section, the rating (4.1 on 1,015 ratings), and the feature description.</li>
        <li>The listing’s version history, for statement scanning (8.2, September 2026) and Household Mode (7.8, July 2026).</li>
      </ul>
      <p class="mt-4 leading-relaxed text-slate-600">
        The listing names its paid tier “Pro Upgrade” and the description calls it Premium; I’ve used
        Premium. Debt Descent’s side comes from the app itself and its <a href="/debt-descent/support/" class="font-medium text-accent-600 transition-colors hover:text-accent-700">support page</a>.
        If something here is out of date, <a href="/contact/" class="font-medium text-accent-600 transition-colors hover:text-accent-700">tell me</a> and I’ll fix it.
      </p>
    </section>

    <DebtDescentTools current="/debt-descent/vs-debt-free/" />

    <p class="mt-16 max-w-[65ch] border-t border-slate-200 pt-6 text-sm leading-relaxed text-slate-500">
      Disclosure: I’m a current client of Consolidated Credit’s debt management plan, and I built
      Debt Descent to track it. Debt Descent is my app, so read this comparison knowing that.
    </p>
  </div>
</Layout>
